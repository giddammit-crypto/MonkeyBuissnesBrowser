#!/bin/sh
set -e

case "$1" in
  configure)
    # Only members of this group may control the privileged firewall daemon.
    if ! getent group linuxsec >/dev/null 2>&1; then
      groupadd --system linuxsec
    fi
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ] && id "${SUDO_USER}" >/dev/null 2>&1; then
      usermod -a -G linuxsec "${SUDO_USER}" || true
    fi

    # Install PolicyKit policy if not present
    if [ -d /usr/share/polkit-1/actions ] && [ -f /opt/Linuxsec/resources/packaging/polkit/org.linuxsec.policy ]; then
      cp /opt/Linuxsec/resources/packaging/polkit/org.linuxsec.policy /usr/share/polkit-1/actions/
    fi

    # Install systemd unit
    if [ -d /etc/systemd/system ] && [ -f /opt/Linuxsec/resources/packaging/systemd/linuxsecd.service ]; then
      cp /opt/Linuxsec/resources/packaging/systemd/linuxsecd.service /etc/systemd/system/
      systemctl daemon-reload || true
      systemctl enable linuxsecd.service || true
      systemctl start linuxsecd.service || true
    fi

    # Update desktop database and icon caches
    update-desktop-database -q || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    ;;
esac

exit 0
