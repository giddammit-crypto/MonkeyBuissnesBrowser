{
  "name": "monkeybuissnesbrowser",
  "version": "0.2.1",
  "description": "SOUL-M8TE — Electron browser with private sessions, tab sleeping and native Chromium tabs.",
  "main": "dist/main/main/main.js",
  "author": {
    "name": "MonkeyBuissnesBrowser",
    "email": "maintainers@monkeybuissnesbrowser.invalid"
  },
  "homepage": "https://monkeybuissnesbrowser.invalid",
  "desktopName": "monkeybuissnesbrowser",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e:smoke": "node scripts/electron-smoke.mjs && node scripts/login-import-smoke.mjs",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.4.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.monkeybuissnes.browser",
    "productName": "SOUL-M8TE",
    "asar": true,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "MonkeyBuissnesBrowser <maintainers@monkeybuissnesbrowser.invalid>",
      "icon": "assets/icons/png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/ico/SOUL-M8TE.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/png/app-icon-512.png"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "SOUL-M8TE-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
